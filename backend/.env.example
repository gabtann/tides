PORT=4000
SECTORS_API_KEY=your_sectors_api_key_here # Key diisi langsung tanpa prefix Bearer
TIDES_API_KEY= # Jika dikosongkan pada mode dev/test lokal, autentikasi akan di-bypass dengan warning. Jika diisi, client wajib mengirim header x-api-key atau Authorization.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173 # Mendukung daftar origin yang dipisahkan koma
AGENT_BASE_URL= # URL layanan AI Agent (mis. http://localhost:8000). Jika dikosongkan, POST /api/agent/investigate akan merespons error AGENT_NOT_CONFIGURED.
GROQ_API_KEY=your_groq_api_key_here
